foreach(required TEST_EXECUTABLE FIXTURE SDK_PREFIX)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(REMOVE_RECURSE "${FIXTURE}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "${TEST_EXECUTABLE}" "${FIXTURE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Joint authoring fixture generation failed: ${result}")
endif()
# The fixture's developer entry point is preserved; the probe has its own source.
configure_file("${CMAKE_CURRENT_LIST_DIR}/joint_authoring_generated_consumer.c" "${FIXTURE}/src/joint_authoring_probe.c" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../../editor_core/tests/runtime_fixture.h" "${FIXTURE}/src/runtime_fixture.h" COPYONLY)
file(WRITE "${FIXTURE}/joint_authoring_probe.cmake" [=[
add_executable(joint_authoring_probe src/joint_authoring_probe.c src/generated/project_objects.c)
target_link_libraries(joint_authoring_probe PRIVATE Rohr::Engine)
if(MSVC)
    target_compile_options(joint_authoring_probe PRIVATE /UNDEBUG)
else()
    target_compile_options(joint_authoring_probe PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
endif()
add_custom_command(TARGET joint_authoring_probe POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_CURRENT_SOURCE_DIR}/objects" "$<TARGET_FILE_DIR:joint_authoring_probe>/objects")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/joint_authoring_probe_path.txt" CONTENT "$<TARGET_FILE:joint_authoring_probe>")
]=])
file(APPEND "${FIXTURE}/CMakeLists.txt" "\ninclude(joint_authoring_probe.cmake)\n")
set(configure "${CMAKE_COMMAND}" -S "${FIXTURE}" -B "${FIXTURE}/consumer_build"
    "-DCMAKE_PREFIX_PATH=${SDK_PREFIX}" "-DCMAKE_BUILD_TYPE=Release")
if(DEFINED TOOLCHAIN)
    list(APPEND configure "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Joint authoring consumer configure failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${FIXTURE}/consumer_build" --parallel 4 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Joint authoring consumer build failed: ${result}")
endif()
if(NOT DEFINED TOOLCHAIN)
    file(READ "${FIXTURE}/consumer_build/joint_authoring_probe_path.txt" executable)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
        "${executable}" WORKING_DIRECTORY "${FIXTURE}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Joint authoring consumer failed: ${result}")
    endif()
endif()
