if(NOT DEFINED CLI OR NOT DEFINED MOCK OR NOT DEFINED FIXTURE_TOOL OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Missing scene CLI test paths")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
execute_process(COMMAND "${FIXTURE_TOOL}" "${TEST_ROOT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not create scene CLI fixture")
endif()
file(TO_CMAKE_PATH "${MOCK}" mock_lua)
file(TO_CMAKE_PATH "${TEST_ROOT}/build.log" log_lua)
file(WRITE "${TEST_ROOT}/editor.lua"
    "return {build={cli={configure={},compile={\"${mock_lua}\",\"${log_lua}\",\"{target}\"}}}}\n")
file(MAKE_DIRECTORY "${TEST_ROOT}/build")
file(WRITE "${TEST_ROOT}/build/rohr_target_scene.txt" "fixture_scene")
function(scene_command expected)
    execute_process(COMMAND "${CLI}" --project "${TEST_ROOT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "success" AND NOT result EQUAL 0)
        message(FATAL_ERROR "Scene command failed: ${output}${error}")
    elseif(expected STREQUAL "failure" AND result EQUAL 0)
        message(FATAL_ERROR "Invalid scene command succeeded: ${ARGN}")
    endif()
endfunction()
scene_command(success --object tug --viewport simulation_viewport build-scene)
file(READ "${TEST_ROOT}/src/generated/scene/project_objects.h" selected)
if(selected MATCHES "typedef struct Example" OR NOT selected MATCHES "typedef struct Tug")
    message(FATAL_ERROR "Object selection was ignored")
endif()
file(READ "${TEST_ROOT}/build.log" commands)
if(NOT commands STREQUAL "fixture_scene\n")
    message(FATAL_ERROR "Wrong compile target: ${commands}")
endif()
scene_command(success build-scene)
file(READ "${TEST_ROOT}/src/generated/scene/project_objects.h" selected)
if(NOT selected MATCHES "typedef struct Example" OR NOT selected MATCHES "typedef struct Tug")
    message(FATAL_ERROR "CLI defaults reused a previous selection")
endif()
file(READ "${TEST_ROOT}/src/generated/scene/project_objects.c" viewport)
string(REGEX MATCHALL "[.]viewport=[{][.]rectangle=" matches "${viewport}")
list(LENGTH matches viewport_count)
if(NOT viewport_count EQUAL 1)
    message(FATAL_ERROR "Default selection created multiple viewports")
endif()
file(SHA256 "${TEST_ROOT}/src/generated/project_scene.c" before)
scene_command(failure --object missing build-scene)
scene_command(failure --viewport missing build-scene)
scene_command(failure --object-id 4294967295 build-scene)
scene_command(failure --viewport-id 0 build-scene)
scene_command(failure --object tug --object example build-scene)
scene_command(failure --viewport-id -1 build-scene)
scene_command(failure --viewport build-scene)
file(SHA256 "${TEST_ROOT}/src/generated/project_scene.c" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Invalid selectors changed generated output")
endif()
file(WRITE "${TEST_ROOT}/editor.lua" "return {build={cli={configure={},compile={}}}}\n")
scene_command(failure simulate-scene)
