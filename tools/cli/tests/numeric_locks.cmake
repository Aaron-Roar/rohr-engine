foreach(required CLI FIXTURE_TOOL TEST_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(project "${TEST_ROOT}/project.json")
execute_process(COMMAND "${FIXTURE_TOOL}" "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Numeric lock fixture failed: ${result}")
endif()
function(run expected)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if((expected STREQUAL "success" AND NOT result EQUAL 0) OR
       (expected STREQUAL "failure" AND result EQUAL 0))
        message(FATAL_ERROR "CLI ${ARGN}: ${result}\n${output}\n${error}")
    endif()
    string(STRIP "${output}" output)
    set(output "${output}" PARENT_SCOPE)
endfunction()
run(success numeric-lock list "${project}")
if(NOT output MATCHES "body 1 0 0 1 0 mass_value")
    message(FATAL_ERROR "Positional lock list did not list the saved lock: ${output}")
endif()
# Dependent selectors may precede the object selector.
set(selectors --body-id 1 --project "${project}" --object-id 1)
run(success ${selectors} lock-get mass_value)
if(NOT output STREQUAL "locked")
    message(FATAL_ERROR "Expected locked, got ${output}")
endif()
file(SHA256 "${project}" before)
run(failure ${selectors} --property mass 9)
file(SHA256 "${project}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Rejected command modified the project")
endif()
run(success ${selectors} unlock mass_value)
run(success ${selectors} --property mass 9)
run(success numeric-lock get "${project}" body 1 0 0 1 0 mass_value)
if(NOT output STREQUAL "unlocked")
    message(FATAL_ERROR "Expected unlocked, got ${output}")
endif()
file(READ "${project}" original)
string(JSON mass GET "${original}" objects 0 rigid_bodies 0 mass)
if(NOT mass EQUAL 9)
    message(FATAL_ERROR "Unlocked mass edit was not saved")
endif()
foreach(version 12 13 14)
    string(JSON data REMOVE "${original}" numeric_locks)
    string(JSON data SET "${data}" format_version ${version})
    file(WRITE "${project}" "${data}")
    run(success numeric-lock list "${project}")
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "Missing lock metadata did not default to empty")
    endif()
    run(success numeric-lock set "${project}" body 1 0 0 1 0 mass_value true)
    file(READ "${project}" saved)
    string(JSON saved_version GET "${saved}" format_version)
    if(NOT saved_version EQUAL 14)
        message(FATAL_ERROR "Legacy project did not save as format 14")
    endif()
endforeach()
string(JSON entry GET "${saved}" numeric_locks 0)
foreach(entries "{}" "[${entry},${entry}]" "[{}]")
    string(JSON invalid SET "${saved}" numeric_locks "${entries}")
    file(WRITE "${project}" "${invalid}")
    run(failure numeric-lock list "${project}")
endforeach()
