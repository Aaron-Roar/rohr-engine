foreach(required TEST_EXECUTABLE CLI FIXTURE SDK_PREFIX)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(REMOVE_RECURSE "${FIXTURE}")
file(MAKE_DIRECTORY "${FIXTURE}/work")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "${TEST_EXECUTABLE}" "${FIXTURE}/project" WORKING_DIRECTORY "${FIXTURE}/work" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Migration fixture failed: ${result}")
endif()
set(project "${FIXTURE}/project")
set(state "${project}/objects/project.rohr.json")
configure_file("${CMAKE_CURRENT_LIST_DIR}/collision_migration_consumer.c" "${project}/src/main.c" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/runtime_fixture.h" "${project}/src/runtime_fixture.h" COPYONLY)
file(SHA256 "${project}/src/main.c" main_before)
file(SHA256 "${state}" original)
execute_process(COMMAND "${CLI}" migrate-collisions preview "${state}" RESULT_VARIABLE result OUTPUT_VARIABLE preview)
if(NOT result EQUAL 0 OR NOT preview MATCHES "pair_equivalence_verified")
    message(FATAL_ERROR "Migration CLI preview failed: ${result}")
endif()
file(SHA256 "${state}" after_preview)
if(NOT original STREQUAL after_preview OR EXISTS "${state}.collision_original")
    message(FATAL_ERROR "Preview changed input or created backups")
endif()
execute_process(COMMAND "${CLI}" migrate-collisions apply "${state}" RESULT_VARIABLE result OUTPUT_VARIABLE report)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Migration CLI apply failed: ${result}")
endif()
file(SHA256 "${state}.collision_original" backup)
if(NOT original STREQUAL backup)
    message(FATAL_ERROR "Original was not preserved exactly")
endif()
foreach(operation validate generate-c)
    execute_process(COMMAND "${CLI}" --project "${project}" "${operation}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Migrated project ${operation} failed: ${result}")
    endif()
endforeach()
file(SHA256 "${project}/src/main.c" main_after)
if(NOT main_before STREQUAL main_after)
    message(FATAL_ERROR "Developer-owned main.c was modified")
endif()
file(WRITE "${project}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(collision_migration LANGUAGES C)
set(CMAKE_C_STANDARD 11)
find_package(Rohr CONFIG REQUIRED)
add_executable(collision_migration src/main.c src/generated/project_objects.c)
target_link_libraries(collision_migration PRIVATE Rohr::Engine)
if(MSVC)
    target_compile_options(collision_migration PRIVATE /UNDEBUG)
else()
    target_compile_options(collision_migration PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
endif()
add_custom_command(TARGET collision_migration POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_CURRENT_SOURCE_DIR}/objects" "$<TARGET_FILE_DIR:collision_migration>/objects")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/executable_path.txt" CONTENT "$<TARGET_FILE:collision_migration>")
]=])
set(configure "${CMAKE_COMMAND}" -S "${project}" -B "${project}/build"
    "-DCMAKE_PREFIX_PATH=${SDK_PREFIX}" "-DCMAKE_BUILD_TYPE=Release")
if(DEFINED TOOLCHAIN)
    list(APPEND configure "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Migration consumer configure failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${project}/build" --parallel 4 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Migration consumer build failed: ${result}")
endif()
if(NOT DEFINED TOOLCHAIN)
    file(READ "${project}/build/executable_path.txt" executable)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
        "${executable}" WORKING_DIRECTORY "${FIXTURE}/work" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Migration consumer execution failed: ${result}")
    endif()
endif()
