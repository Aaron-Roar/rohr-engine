foreach(required CLI PROBE FIXTURE SDK_PREFIX)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${ARGV}\n${result}\n${output}\n${error}")
    endif()
endfunction()
file(REMOVE_RECURSE "${FIXTURE}")
run("${CLI}" --project "${FIXTURE}" create)
configure_file("${CMAKE_CURRENT_LIST_DIR}/partial_spawning_consumer.c" "${FIXTURE}/src/main.c" COPYONLY)
file(SHA256 "${FIXTURE}/src/main.c" before)
file(WRITE "${FIXTURE}/editor.lua"
    "return {build={project={configure={'cmake','-S','{project}','-B','{build}','-DCMAKE_BUILD_TYPE=Debug','-DCMAKE_PREFIX_PATH=${SDK_PREFIX}','-DCMAKE_C_FLAGS=-Wall -Wextra -Wpedantic -UNDEBUG'}}}}\n")
run("${CLI}" --project "${FIXTURE}" build)
file(SHA256 "${FIXTURE}/src/main.c" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Generation overwrote developer main.c")
endif()
file(READ "${FIXTURE}/build/rohr_application_Debug.path" executable)
foreach(mode partial full missing)
    run("${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy "${executable}" "${mode}")
endforeach()
run("${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "${PROBE}" launch "${FIXTURE}" scene "${SDK_PREFIX}")
