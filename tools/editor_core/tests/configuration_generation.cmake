foreach(required TEST_EXECUTABLE FIXTURE FONT CONSUMER_SOURCE SDK_PREFIX)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(REMOVE_RECURSE "${FIXTURE}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
    "${TEST_EXECUTABLE}" "${FIXTURE}" "${FONT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Configuration fixture generation failed: ${result}")
endif()
configure_file("${CONSUMER_SOURCE}" "${FIXTURE}/src/main.c" COPYONLY)
file(WRITE "${FIXTURE}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(configuration_parity LANGUAGES C)
set(CMAKE_C_STANDARD 11)
find_package(Rohr CONFIG REQUIRED)
add_executable(configuration_parity src/main.c src/generated/project_objects.c src/generated/project_viewports.c)
target_link_libraries(configuration_parity PRIVATE Rohr::Engine)
if(MSVC)
    target_compile_options(configuration_parity PRIVATE /UNDEBUG)
else()
    target_compile_options(configuration_parity PRIVATE -Wall -Wextra -Wpedantic -UNDEBUG)
endif()
add_custom_command(TARGET configuration_parity POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_CURRENT_SOURCE_DIR}/assets" "$<TARGET_FILE_DIR:configuration_parity>/assets")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/executable_path.txt" CONTENT "$<TARGET_FILE:configuration_parity>")
]=])
set(configure "${CMAKE_COMMAND}" -S "${FIXTURE}" -B "${FIXTURE}/build"
    "-DCMAKE_PREFIX_PATH=${SDK_PREFIX}" "-DCMAKE_BUILD_TYPE=Release")
if(DEFINED TOOLCHAIN)
    list(APPEND configure "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Configuration consumer configure failed: ${result}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${FIXTURE}/build" --parallel 4 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Configuration consumer build failed: ${result}")
endif()
if(NOT DEFINED TOOLCHAIN)
    file(READ "${FIXTURE}/build/executable_path.txt" executable)
    file(MAKE_DIRECTORY "${FIXTURE}/outside_source")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
        "${executable}" WORKING_DIRECTORY "${FIXTURE}/outside_source" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Configuration consumer execution failed: ${result}")
    endif()
endif()
